msgstr "El código \"%(codigo)s\" ya existe."

msgid "%(cuantas)d already existed."
msgstr "%(cuantas)d ya existían."

msgid "No files were selected."
msgstr "No se seleccionaron archivos."

msgid "Invalid IDs."
msgstr "Los identificadores no son válidos."

msgid "None of the selected files exist."
msgstr "Ninguno de los archivos seleccionados existe."

msgid "No records selected."
msgstr "No hay registros seleccionados."

msgid "No records found."
msgstr "No se encontró ningún registro."

msgid "With several customers you must type at least one address in the \"Email address\" field."
msgstr "Con varios clientes tienes que escribir al menos un correo en el campo \"Email address\"."

msgid "There are no recipients. Type an address in the field above."
msgstr "No hay destinatarios. Escribe un correo en el campo de arriba."

msgid "Category and Name are required."
msgstr "Faltan la categoría y el nombre."

msgid "Only an administrator can create customers."
msgstr "Solo un administrador puede dar de alta clientes."

msgid "Username and password are both required."
msgstr "Hacen falta el usuario y la contraseña."

msgid "Tenant name is required."
msgstr "Falta el nombre de la empresa."

msgid "%(numero)s marked as paid."
msgstr "%(numero)s marcada como pagada."

msgid "A cancelled invoice is not sent to anyone."
msgstr "Una factura cancelada no se le manda a nadie."

msgid "%(numero)s sent to %(destinatario)s."
msgstr "%(numero)s enviada a %(destinatario)s."

msgid "Cancelling an invoice needs a reason."
msgstr "Hace falta un motivo para cancelar una factura."

msgid "%(numero)s cancelled."
msgstr "%(numero)s cancelada."

msgid "Write a message or attach a file."
msgstr "Escribe un mensaje o adjunta un archivo."

msgid "Invalid date format."
msgstr "El formato de la fecha no es válido."

msgid "Report sent to %(destinatario)s."
msgstr "Informe enviado a %(destinatario)s."

msgid "WhatsApp sent to %(numero)s."
msgstr "WhatsApp enviado a %(numero)s."

msgid "Fill at least one level (zone, aisle, rack...)."
msgstr "Rellena al menos un nivel (zona, pasillo, estante...)."

msgid "Report with %(n)s record(s) sent to %(destinatarios)s."
msgstr "Informe con %(n)s registro(s) enviado a %(destinatarios)s."

msgid "Username \"%(usuario)s\" is already taken. Nothing was created — pick a different username."
msgstr "El usuario \"%(usuario)s\" ya está ocupado. No se creó nada: elige otro nombre."

msgid "\"%(usuario)s\" can now sign in as %(cliente)s. The password is not stored anywhere — hand it over now."
msgstr "\"%(usuario)s\" ya puede entrar en nombre de %(cliente)s. La contraseña no se guarda en ningún sitio: entrégasela ahora."

msgid "You cannot create a user with the role \"%(rol)s\"."
msgstr "No puedes crear un usuario con el rol \"%(rol)s\"."

msgid "Could not derive a valid subdomain from the name provided."
msgstr "No se pudo sacar un subdominio válido del nombre indicado."

msgid "%(empresa)s already has invoice %(numero)s for that period. Tick the box if you want to issue another one anyway."
msgstr "%(empresa)s ya tiene la factura %(numero)s para ese periodo. Marca la casilla si aun así quieres emitir otra."

msgid "Username and password are required."
msgstr "Hacen falta el usuario y la contraseña."

msgid "A message cannot go over %(maximo)s characters."
msgstr "El mensaje no puede pasar de %(maximo)s caracteres."

msgid "No more than %(maximo)s files per message. For a complete file use the Digital panel."
msgstr "No más de %(maximo)s archivos por mensaje. Para un expediente completo usa el panel Digital."

msgid "\"%(archivo)s\" is over %(mb)s MB. Large files go through the Digital panel."
msgstr "\"%(archivo)s\" pasa de %(mb)s MB. Los archivos grandes van por el panel Digital."

msgid "Select a warehouse first."
msgstr "Elige primero una bodega."

msgid "Could not send: %(error)s"
msgstr "No se pudo enviar: %(error)s"

msgid "You cannot manage the account of \"%(usuario)s\"."
msgstr "No puedes administrar la cuenta de \"%(usuario)s\"."

msgid "User deleted."
msgstr "Usuario borrado."

msgid "The logo of \"%(nombre)s\" was removed."
msgstr "Se quitó el logo de \"%(nombre)s\"."

msgid "Tenant name is required. Nothing was changed."
msgstr "Falta el nombre de la empresa. No se cambió nada."

msgid "Subdomain \"%(subdominio)s\" is already in use."
msgstr "El subdominio \"%(subdominio)s\" ya está en uso."

msgid "Logo of \"%(nombre)s\" updated."
msgstr "Logo de \"%(nombre)s\" actualizado."

msgid "Could not derive a valid subdomain. Nothing was changed."
msgstr "No se pudo sacar un subdominio válido. No se cambió nada."

msgid "Unknown platform role \"%(rol)s\"."
msgstr "El rol de plataforma \"%(rol)s\" no existe."

msgid "Platform user \"%(usuario)s\" created as %(rol)s."
msgstr "Usuario de plataforma \"%(usuario)s\" creado como %(rol)s."

msgid "You cannot change your own platform role."
msgstr "No puedes cambiar tu propio rol de plataforma."

msgid "\"%(usuario)s\" is now %(rol)s."
msgstr "\"%(usuario)s\" ahora es %(rol)s."

msgid "You cannot revoke your own platform access."
msgstr "No puedes quitarte tu propio acceso de plataforma."

msgid "Platform access revoked for \"%(nombre)s\"."
msgstr "Se retiró el acceso de plataforma a \"%(nombre)s\"."

msgid "User \"%(usuario)s\" created with role \"%(rol)s\". The password is not stored anywhere — write it down or set a new one later."
msgstr "Usuario \"%(usuario)s\" creado con el rol \"%(rol)s\". La contraseña no se guarda en ningún sitio: apúntala o asígnale otra después."

msgid "Username \"%(usuario)s\" already exists."
msgstr "El usuario \"%(usuario)s\" ya existe."

msgid "You cannot change the password of \"%(usuario)s\"."
msgstr "No puedes cambiar la contraseña de \"%(usuario)s\"."

