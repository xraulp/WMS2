msgstr "Este cliente no tiene número de WhatsApp."

msgid "WhatsApp is not configured on the server."
msgstr "WhatsApp no está configurado en el servidor."

msgid "WhatsApp failed: %(error)s"
msgstr "El WhatsApp falló: %(error)s"

