msgstr "No tienes contraseña de borrado configurada. Pídesela al administrador de la empresa."

msgid "Write the reason for the deletion."
msgstr "Escribe el motivo del borrado."

msgid "Record deleted successfully."
msgstr "Registro borrado."

msgid "No files attached."
msgstr "No hay archivos adjuntos."

msgid "Warehouse %(codigo)s created."
msgstr "Bodega %(codigo)s creada."

msgid "That would create %(cuantas)d locations, over the limit of %(tope)d. Split it into smaller runs."
msgstr "Eso crearía %(cuantas)d posiciones, más del tope de %(tope)d. Hazlo en tandas más chicas."

msgid "Please select at least one customer, or choose All Customers."
msgstr "Elige al menos un cliente, o marca todos los clientes."

msgid "%(nombre)s (%(categoria)s) saved."
msgstr "%(nombre)s (%(categoria)s) guardado."

msgid "A user linked to a customer must have the role \"customer\". \"%(rol)s\" is a company role and would see every operation of every customer. Nothing was changed."
msgstr "Un usuario ligado a un cliente tiene que llevar el rol \"customer\". \"%(rol)s\" es un rol de la casa y vería todas las operaciones de todos los clientes. No se cambió nada."

msgid "No file uploaded."
msgstr "No se subió ningún archivo."

msgid "%(cuantas)s operation(s) imported successfully."
msgstr "%(cuantas)s operación(es) importadas."

msgid "No file."
msgstr "No hay archivo."

msgid "%(cuantas)s catalog entries imported."
msgstr "%(cuantas)s fichas de catálogo importadas."

msgid "Only a platform administrator can do this."
msgstr "Esto solo lo puede hacer un administrador de la plataforma."

msgid "The logo was not saved: it has to be %(formatos)s."
msgstr "El logo no se guardó: tiene que ser %(formatos)s."

msgid "The logo was not saved: it is over %(mb)s MB."
msgstr "El logo no se guardó: pasa de %(mb)s MB."

msgid "The logo was not saved: the storage did not respond."
msgstr "El logo no se guardó: el almacén no respondió."

msgid "Choose the company being invoiced."
msgstr "Elige la empresa a la que se factura."

msgid "That company does not exist."
msgstr "Esa empresa no existe."

msgid "The amount has to be a number greater than zero."
msgstr "El monto tiene que ser un número mayor que cero."

msgid "The period is not a valid month."
msgstr "El periodo no es un mes válido."

msgid "The due date is not valid."
msgstr "La fecha de vencimiento no es válida."

msgid "Invoice %(numero)s issued to %(empresa)s for %(monto)s USD."
msgstr "Factura %(numero)s emitida a %(empresa)s por %(monto)s USD."

msgid "Your message was sent, but the file could not be uploaded. Try again from the Digital panel."
msgstr "Tu mensaje se envió, pero el archivo no se pudo subir. Vuelve a intentarlo desde el panel Digital."

msgid "Invalid credentials."
msgstr "Usuario o contraseña incorrectos."

msgid "Type of Operation is required."
msgstr "Falta el tipo de operación."

msgid "Date is required."
msgstr "Falta la fecha."

msgid "Incorrect password. Record #%(pk)s was NOT deleted."
msgstr "Contraseña incorrecta. El registro n.º %(pk)s NO se borró."

msgid "Recipient email required."
msgstr "Falta el correo del destinatario."

msgid "Email failed: %(error)s"
msgstr "El correo falló: %(error)s"

